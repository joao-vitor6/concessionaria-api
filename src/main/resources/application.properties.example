spring.datasource.url=jdbc:mysql://localhost:3306/concessionaria_db
spring.datasource.username=root
spring.datasource.password=SUA_SENHA_DO_MYSQL_AQUI

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

server.port=9090

admin.default.email=admin@concessionaria.com
admin.default.senha=ESCOLHA_UMA_SENHA_FORTE_AQUI

jwt.secret=GERE_UMA_STRING_ALEATORIA_LONGA_AQUI